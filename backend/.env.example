# Template env backend — salin menjadi `.env` lalu isi nilai asli.
# JANGAN commit `.env` (sudah diabaikan di .gitignore + .dockerignore).
# Lihat docs/ENVIRONMENT.md untuk penjelasan tiap variabel.

# ===== App =====
APP_ENV=development
APP_NAME=ai-store
BACKEND_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# DEBUG=true mengaktifkan /api/v1/dev/* (mock WA) — WAJIB false di production (P5)
DEBUG=true
# Seed otomatis saat startup bila DB kosong — WAJIB false di production (P5)
SEED_ON_STARTUP=true
# Interval (menit) job maintenance: expire promo + purge idempotency keys
MAINTENANCE_INTERVAL_MINUTES=5
# Nama toko (tampilan default bila tidak ada di DB)
STORE_NAME=Toko Demo

# ===== Business defaults (SRS ratifikasi §11) =====
LOW_STOCK_THRESHOLD_DEFAULT=5
STOCKOUT_RISK_DAYS=7
MAX_DISCOUNT_PERCENT=50
IDEMPOTENCY_TTL_MINUTES=30

# ===== Database (Supabase) =====
# Pakai SESSION POOLER (port 5432) — bukan transaction pooler 6543:
# asyncpg memakai prepared statement yang tidak kompatibel dengan transaction mode.
# Supabase Dashboard > Project Settings > Database > Connection string > Session pooler:
# postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Khusus pytest — JANGAN arahkan ke Supabase (conftest drop/create tabel per test).
# Jalankan Postgres test terpisah (container mandiri, di luar compose):
#   docker run -d --name ai-store-test-pg -e POSTGRES_USER=store -e POSTGRES_PASSWORD=store -e POSTGRES_DB=store -p 5432:5432 postgres:16-alpine
#   docker exec ai-store-test-pg psql -U store -d store -c "CREATE DATABASE store_test;"
DATABASE_URL_TEST=postgresql+asyncpg://store:store@localhost:5432/store_test

# Supabase — kredensial project (dashboard → Project Settings → API)
# SUPABASE_URL: https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY: public/publishable key (Project Settings → API Keys)
# SUPABASE_SERVICE_ROLE_KEY: secret key — HANYA untuk backend, jangan pernah dikirim ke frontend
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===== Auth =====
JWT_SECRET_KEY=change-me-64-char-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SEED_OWNER_EMAIL=owner@store.demo
SEED_DEFAULT_PASSWORD=ChangeMe123!

# ===== AI / LLM (Groq — semua Qwen) =====
LLM_PROVIDER=mock            # mock | openai | google | groq
LLM_API_KEY=                 # jalur generik openai/google
GROQ_API_KEY=                # isi dari console.groq.com → API Keys (gsk_...)
GROQ_MODEL_FAST=qwen/qwen3.8-27b       # Sales Agent
GROQ_MODEL_REASONING=qwen/qwen3.8-27b  # Analyst + Action Assistant
LLM_MODEL_SALES=
LLM_MODEL_ANALYST=
LLM_MODEL_ACTION=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
LLM_MONTHLY_BUDGET_IDR=300000

# ===== WhatsApp / WABA =====
WA_PROVIDER=mock             # mock | meta
WA_VERIFY_TOKEN=my-verify-token
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_API_VERSION=v21.0
WA_TEST_NUMBERS=
WA_TEMPLATE_ORDER_CONFIRM=order_confirmation

# ===== Seed =====
SEED_SKU_COUNT=100
