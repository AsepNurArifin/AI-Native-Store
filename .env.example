# Fullstack Nuxt — satu .env untuk FE + API (tanpa backend Python).
# Salin menjadi `.env` lalu isi nilai asli. JANGAN commit `.env`.

# API satu origin (relatif). Override absolut hanya bila API di domain terpisah.
NUXT_PUBLIC_API_BASE=/api/v1
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# ===== App =====
APP_ENV=development
DEBUG=true
# Seed otomatis saat request pertama bila tabel users kosong — WAJIB false di production
SEED_ON_STARTUP=true
STORE_NAME=Toko Demo

# ===== Business defaults =====
LOW_STOCK_THRESHOLD_DEFAULT=5
STOCKOUT_RISK_DAYS=7
MAX_DISCOUNT_PERCENT=50
IDEMPOTENCY_TTL_MINUTES=30

# ===== Database (Supabase session pooler :5432) =====
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# ===== Supabase Storage (upload gambar produk) =====
# Settings → API: Project URL + service_role key (server-only, JANGAN commit/share)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ===== Auth =====
JWT_SECRET_KEY=change-me-64-char-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
SEED_OWNER_EMAIL=owner@store.demo
SEED_DEFAULT_PASSWORD=ChangeMe123!

# ===== AI / LLM (Groq / OpenRouter — Qwen) =====
LLM_PROVIDER=mock
LLM_API_KEY=
GROQ_API_KEY=
GROQ_MODEL_FAST=qwen/qwen3-32b
GROQ_MODEL_REASONING=qwen/qwen3-32b
OPENROUTER_API_KEY=
OPENROUTER_MODEL_FAST=qwen/qwen3-32b:free
OPENROUTER_MODEL_REASONING=qwen/qwen3-32b:free
LLM_MODEL_SALES=
LLM_MODEL_ANALYST=
LLM_MODEL_ACTION=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2

# ===== Telegram =====
TELEGRAM_PROVIDER=mock
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_BASE=https://api.telegram.org

# ===== Seed =====
SEED_SKU_COUNT=100
