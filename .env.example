# Fullstack Nuxt — satu .env untuk FE + API (tanpa backend Python).
# Salin menjadi `.env` lalu isi nilai asli. JANGAN commit `.env`.

# API satu origin (relatif). Override absolut hanya bila API di domain terpisah.
NUXT_PUBLIC_API_BASE=/api/v1
NUXT_PUBLIC_SITE_URL=https://shafs-store.vercel.app

# ===== App =====
# PENTING di produksi: set APP_ENV=production secara eksplisit.
# `nuxt build` memaksa NODE_ENV=production, jadi `appEnv` di nuxt.config TIDAK
# lagi memakai NODE_ENV sebagai fallback ( dulu build Vercel tanpa APP_ENV diam-diam
# jadi mode production dan guard menolak boot -> 500 FUNCTION_INVOCATION_FAILED
# di semua route). Sumber kebenaran sekarang: APP_ENV, atau VERCEL_ENV untuk
# auto-deteksi di Vercel (production -> production, preview -> development).
APP_ENV=production
DEBUG=false
# Seed otomatis saat request pertama bila tabel users kosong — WAJIB false di production
SEED_ON_STARTUP=false
# ===== Business defaults =====
LOW_STOCK_THRESHOLD_DEFAULT=5
STOCKOUT_RISK_DAYS=7
MAX_DISCOUNT_PERCENT=50
IDEMPOTENCY_TTL_MINUTES=30
# Batas pembayaran order sebelum auto-CANCELLED + stok dikembalikan.
# Order payment_status=UNPAID yang lewat TTL ini dibatalkan saat endpoint baca
# (GET /orders, GET /inventory/summary) dijalankan — lazy expiry, tanpa cron.
ORDER_TTL_MINUTES=120

# ===== Database (Supabase TRANSACTION pooler :6543) =====
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# WAJIB port 6543 (transaction pooler), BUKAN 5432 (session pooler).
# Kenapa: Vercel membekukan lambda di antara request, sehingga timer idle_timeout
# driver DB tidak pernah jalan. Dengan session pooler tiap koneksi client mengunci
# satu backend Postgres khusus; slot terkumpul dari cold start dan begitu capai
# 15 (`max clients ... pool_size: 15`) SEMUA request kena `EMAXCONNSESSION`
# -> /api/v1/health 503, /catalog/* 500. Transaction pooler memakai satu backend
# untuk banyak client (prepare:false sudah diset di server/utils/db.ts), jadi
# lambda yang beku tidak lagi mengunci slot apa pun.
DATABASE_URL=

# ===== Supabase Storage (upload gambar produk) =====
# Settings → API: Project URL + service_role key (server-only, JANGAN commit/share)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ===== Auth =====
JWT_SECRET_KEY=change-me-64-char-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
SEED_OWNER_EMAIL=owner@store.demo
SEED_DEFAULT_PASSWORD=ChangeMe123!

# ===== AI / LLM (Groq / OpenRouter — Qwen) =====
LLM_PROVIDER=mock
LLM_API_KEY=
GROQ_API_KEY=
GROQ_MODEL_FAST=qwen/qwen3-32b
GROQ_MODEL_REASONING=qwen/qwen3-32b
OPENROUTER_API_KEY=
OPENROUTER_MODEL_FAST=qwen/qwen3-32b:free
OPENROUTER_MODEL_REASONING=qwen/qwen3-32b:free
LLM_MODEL_SALES=
LLM_MODEL_ANALYST=
LLM_MODEL_ACTION=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2

# ===== Telegram =====
TELEGRAM_PROVIDER=mock
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_BASE=https://api.telegram.org

# ===== Seed =====
# Katalog demo di-seed 12 SKU oleh ensureSeeded (lihat server/utils/seed.ts).

# ===== Deploy ke Vercel =====
# Di Vercel TIDAK ada file .env (gitignored), jadi semua nilainya diambil dari
# Project → Settings → Environment Variables. WAJIB pakai awalan `NUXT_`:
# Nitro hanya meng-override runtimeConfig dari env berawalan `NUXT_` saat
# runtime. Nama telanjang (DATABASE_URL, DEBUG, ...) hanya terbaca kalau ada
# saat BUILD — artinya harus redeploy tiap kali diubah, dan Community plan
# membatasi jumlah build harian. Isi ulang pakai awalan NUXT_:
#
#   NUXT_APP_ENV=production
#   NUXT_DEBUG=false
#   NUXT_SEED_ON_STARTUP=false
#   NUXT_DATABASE_URL=<isi DATABASE_URL>
#   NUXT_SUPABASE_URL=<isi SUPABASE_URL>
#   NUXT_SUPABASE_SERVICE_ROLE_KEY=<isi SUPABASE_SERVICE_ROLE_KEY>
#   NUXT_JWT_SECRET_KEY=<isi JWT_SECRET_KEY>
#   NUXT_SEED_OWNER_EMAIL=<isi SEED_OWNER_EMAIL>
#   NUXT_SEED_DEFAULT_PASSWORD=<isi SEED_DEFAULT_PASSWORD>
#   NUXT_LLM_PROVIDER=<isi LLM_PROVIDER>          # groq / openrouter / mock
#   NUXT_LLM_API_KEY=<isi LLM_API_KEY>
#   NUXT_GROQ_API_KEY=<isi GROQ_API_KEY>
#   NUXT_GROQ_MODEL_FAST=<isi GROQ_MODEL_FAST>
#   NUXT_GROQ_MODEL_REASONING=<isi GROQ_MODEL_REASONING>
#   NUXT_OPENROUTER_API_KEY=<isi OPENROUTER_API_KEY>
#   NUXT_TELEGRAM_PROVIDER=<isi TELEGRAM_PROVIDER>  # bot / mock
#   NUXT_TELEGRAM_BOT_TOKEN=<isi TELEGRAM_BOT_TOKEN>
#   NUXT_TELEGRAM_WEBHOOK_SECRET=<isi TELEGRAM_WEBHOOK_SECRET>
#   NUXT_PUBLIC_SITE_URL=https://<domain>.vercel.app
#
# Guard produksi (server/plugins/00-assert-production.ts) menolak boot bila
# salah satu ini belum aman. Kalau boot gagal, cek Vercel → Logs, cari
# `[config] GAGAL guard produksi:` — pesan itu mencantumkan SELURUH env yang
# kurang sekaligus, bukan hanya yang pertama ketemu.
